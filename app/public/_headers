# Build output (file names carry a content hash, so they never change).
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images, frames and video: cache for a week, refresh quietly in the background.
/assets/world/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/assets/work/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/assets/niche/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/assets/team/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/assets/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/assets/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/assets/landing/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/assets/og.jpg
  Cache-Control: public, max-age=86400
/assets/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
